# ========================================================
# AUTOPORTONAGER PRODUCTION ENVIRONMENT VARIABLES (COOLIFY)
# ========================================================

# Django Core
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=generate-a-strong-random-secret-key-here-with-64-characters
DEBUG=False
LOCAL_MODE=False

# Host & Domains
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://api.tudominio.com,https://app.tudominio.com
CORS_ALLOWED_ORIGINS=https://app.tudominio.com,http://localhost:3000

# Database (PostgreSQL provided by Coolify)
# Example: postgresql://postgres:password@postgres-db:5432/autoportonager
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (for Celery & Caching provided by Coolify)
# Example: redis://redis-service:6379/1
CELERY_BROKER_URL=redis://redis:6379/1

# Master Encryption Key for Fernet Secrets (32 bytes url-safe base64 encoded)
# Example generated via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=dGhpcy1pcy1hLXRlc3QtZmVybmV0LWtleS0zMmJ5dGVzPT0=

# Alpaca Platform (Default Credentials for System Operations / Paper Fallback)
ALPACA_API_KEY=PK...
ALPACA_API_SECRET=...
ALPACA_PAPER=True

# Notifications & Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
